# Database
# Use Option B: SQLite for easy setup
# DATABASE_URL="file:./dev.db"

# Use Option A: PostgreSQL (Production)
DATABASE_URL="postgresql://user:password@localhost:5432/zenla_db?schema=public"

# Auth
# Generate a secret: npx auth secret
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# For production (Vercel): set `NEXTAUTH_URL` as an environment variable
# Example: NEXTAUTH_URL="https://your-app.vercel.app" or your custom domain
# Ensure NEXTAUTH_SECRET is also set in Vercel and do NOT commit real secrets.

# Social Auth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
